# Copy to .env and fill in. Never commit .env.
# Signing key for API tokens; generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SRE_JWT_SECRET=
# For running the API or worker outside Docker against the compose database:
SRE_DATABASE_URL=postgresql+psycopg://sre:sre@localhost:5432/sre
