    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "12.23.24",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.4",
    "recharts": "3.3.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.16",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.12",
